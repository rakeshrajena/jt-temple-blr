# Temple public site at document root (index.html + assets). Booking/, crm/, Streaming/ are siblings.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Serve home photos, gallery, and gallery API from home/ (do not redirect to root).
  RewriteRule ^home/(photos|gallery|api)/ - [L]
  # React Router: /gallery is a page, not a disk folder.
  RewriteRule ^gallery/?$ index.html [L]
  # Old URLs: /home/... → site root (other paths only).
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^home/(.+)$ /$1 [R=301,L]
</IfModule>