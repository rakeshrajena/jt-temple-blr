# The project configuration sits beside the php folder on this computer.
# It must not be downloaded. On the server, keep .env beside index.php or one folder above the site.
<FilesMatch "(?i)^\.env.*$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
