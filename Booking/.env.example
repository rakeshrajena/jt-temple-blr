# ---------------------------------------------------------------
# Shree Jagannatha Temple Bengaluru - Booking System configuration
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit or share the real .env file. Keep it outside public_html.
# ---------------------------------------------------------------

# "production" hides error details from visitors; use "staging" for the test copy.
APP_ENV=production
APP_DEBUG=false
# Full public URL of the booking app, no trailing slash.
# Production: https://sjtbengaluru.org/Booking
# Local AMPPS (example): http://localhost:8080/jt_blr/jt-temple-blr/Booking
APP_URL=https://sjtbengaluru.org/Booking
APP_TIMEZONE=Asia/Kolkata
# Long random string (64+ chars). Generate with:  php bin/console.php key
APP_KEY=change-me-to-a-long-random-string

# One-time web setup — at least 16 random characters (same value as crm/.env INSTALL_TOKEN when both apps are deployed).
# Unified installer: crm/install.php or Booking/install.php runs ERP + all Booking migrations in one step.
# Remove after setup succeeds.
INSTALL_TOKEN=change-me-before-upload

# ---------------- Shared temple ERP (php/) on the same server ----------------
# Upload Booking/ next to crm/ (e.g. public_html/Booking and public_html/crm).
# Use the SAME MySQL database as crm/.env — paid bookings post to ERP donations/receipts.
# ERP_APP_URL: public ERP base (no trailing slash). Used for staff SSO redirects.
# ERP_APP_URL=https://sjtbengaluru.org/crm
#
# Single sign-on with ERP admin (default true when DB has ERP users + donors).
# STAFF_SSO=false restores a separate /Booking/admin/login page.
# STAFF_SESSION_NAME=jt_blr_session
# STAFF_SESSION_PATH=/Booking
# STAFF_SESSION_SAVE_PATH=
# ERP_APP_URL=
#
# Prasadam menu: read food_coupon_catalog from ERP (default true). false = legacy booking_coupons only.
# USE_ERP_COUPON_CATALOG=true

# Database — may be the SAME MySQL database as the temple ERP (php/), e.g. sjt_temple_blr.
# Run: php bin/console.php migrate   (adds booking tables + schema_migrations; ERP tables unchanged)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sjt_temple_blr
DB_USER=root
DB_PASS=mysql
# On cPanel you may use DB_PASSWORD instead of DB_PASS (same value as crm/.env).
# Only used when DB_DRIVER=sqlite (local development / automated tests)
DB_PATH=storage/database.sqlite

# Set to the header name ONLY if the site sits behind Cloudflare or another proxy,
# e.g. CF-Connecting-IP. Leave empty on plain cPanel hosting.
TRUSTED_IP_HEADER=

# Max bookings submitted per hour from one network (the temple office may book for devotees).
BOOKING_RATE_LIMIT_PER_HOUR=40

# ---------------- WhatsApp Business Platform (Cloud API) ----------------
# From Meta Business Manager > WhatsApp > API Setup. Leave empty until approved;
# bookings still work and every unsent message is logged for follow-up.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# Used to verify webhook calls from Meta (App Dashboard > App settings > Basic > App secret)
WA_APP_SECRET=
# Any random string; enter the same value in Meta's webhook configuration
WA_WEBHOOK_VERIFY_TOKEN=

# ---------------- Devotee payments (Razorpay) ----------------
# Set PAYMENT_GATEWAY=razorpay and your keys (test keys from dashboard.razorpay.com for staging).
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
# Production: use rzp_live_... keys from Razorpay dashboard (never commit real secrets).
RAZORPAY_KEY_SECRET=your_test_secret_here
# Optional. Leave empty until you add a webhook in Razorpay dashboard (Webhooks > secret).
# Pay now + browser verify works with only KEY_ID + KEY_SECRET. Webhook is a backup if the devotee closes the tab before verify.
RAZORPAY_WEBHOOK_SECRET=

# TLS for outbound gateway API (Razorpay). Default true. On local AMPPS you may need false until curl.cainfo is set.
# Always forced true when APP_ENV=production.
GATEWAY_SSL_VERIFY=true

# Legacy UPI QR + UTR on the pay page. Default false = Razorpay only for devotees.
# Staff can still verify/record payments in admin. Set true to show UPI QR + reference form again.
BOOKING_UPI_MANUAL=false
