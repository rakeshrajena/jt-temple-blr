# Temple booking app — single-folder deploy (same layout as the ERP php/ app).
# Served at /Booking. Static assets live in /assets and are real files.

# Configuration and schema are never downloadable, even when rewrite rules are off.
<FilesMatch "(?i)^(\.env.*|schema\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Pass the Authorization header through (used by some hosts)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Never serve dotfiles or application internals directly
    RewriteRule (^|/)\. - [F]
    RewriteRule ^(app|bin|migrations|storage|tests|docs)(/|$) - [F]

    # One-time web setup (delete install.php after use)
    RewriteRule ^install\.php$ - [L]

    # Static assets and any real files are served as-is; everything else goes to index.php
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>
