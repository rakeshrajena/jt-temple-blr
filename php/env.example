# Copy this file to .env in the same folder as index.php.
# The web server is not allowed to download .env.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# One-time setup key for install.php (and Booking/install.php — same key). Use at least 16 random characters.
# One submit runs ERP tables + all Booking migrations when Booking/ is beside php/.
# Delete this line after setup succeeds.
INSTALL_TOKEN=replace-with-a-long-random-key

# Optional public address used inside coupon QR codes, with no path.
# Set this on the server so a phone opens the live site. Example: https://temple.example
# APP_URL=https://your-temple-domain

# Online booking app (sibling Booking/ folder). Required for ERP › Online booking links.
# Production example:
# BOOKING_APP_URL=https://sjtbengaluru.org/Booking
# BOOKING_ADMIN_URL=https://sjtbengaluru.org/Booking/admin
# Local AMPPS example:
# BOOKING_APP_URL=http://localhost/jt_blr/jt-temple-blr/Booking
# BOOKING_ADMIN_URL=http://localhost/jt_blr/jt-temple-blr/Booking/admin

# Shared staff session (ERP + Booking admin). Cookie path defaults to the parent of php/ and Booking/.
# STAFF_SESSION_PATH=/jt_blr/jt-temple-blr

# Optional. A scanner can call the coupon API with this token instead of a browser session.
# Use at least 16 random characters. Leave the line out to allow only signed-in staff.
# COUPON_API_TOKEN=replace-with-a-long-random-key
