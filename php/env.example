# Copy this file to .env in the same folder as index.php.
# The web server is not allowed to download .env.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# One-time setup key for install.php. Use at least 16 random characters.
# Delete this line after the tables and demo data are created.
INSTALL_TOKEN=replace-with-a-long-random-key
