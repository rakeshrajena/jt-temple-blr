# Generated donation receipts and coupon PDFs
php/storage/receipts/*
php/storage/coupons/*
!php/storage/receipts/.gitkeep
!php/storage/coupons/.gitkeep

# Uploaded bank statements
php/storage/uploads/*
!php/storage/uploads/.gitkeep

# Expense bill copies
php/storage/vouchers/*
!php/storage/vouchers/.gitkeep

# Runtime logs
php/storage/logs/*
!php/storage/logs/.gitkeep

# Books copied onto the server by install.php. Kept off git because it holds the live records.
php/storage/install/*
!php/storage/install/.gitkeep

# Python bytecode, virtualenv, and the local SQLite database
python/**/__pycache__/
python/**/*.py[cod]
python/.venv/
python/venv/
python/*.db
python/*.log
python/uploads/*
python/receipts/*
!python/uploads/.gitkeep
!python/receipts/.gitkeep

# Booking app — secrets and runtime data (match Booking/ and booking/ for case-sensitive git)
Booking/.env
Booking/.env.*
!Booking/.env.example
booking/.env
booking/.env.*
!booking/.env.example
Booking/storage/*.sqlite*
Booking/storage/logs/*
Booking/storage/sessions/*
Booking/storage/cache/*
Booking/storage/uploads/*
Booking/storage/backups/*
Booking/storage/install/*
booking/storage/*.sqlite*
booking/storage/logs/*
booking/storage/sessions/*
booking/storage/cache/*
booking/storage/uploads/*
booking/storage/backups/*
booking/storage/install/*
!Booking/storage/**/.htaccess
!Booking/storage/**/.gitignore
!booking/storage/**/.htaccess
!booking/storage/**/.gitignore

# Temple ERP (php/) — local config with DB/SMTP secrets
php/.env
php/.env.*
!php/env.example

# Local secrets (any directory)
.env
.env.*
!.env.example
!**/.env.example
!**/env.example

# Credentials / keys (never commit)
*.pem
*.key
*.p12
*.pfx
credentials.json
*credentials*.json
secrets.json
**/id_rsa
**/id_rsa.*
**/.mysql_password
sjt-booking-release.zip

# OS and editor files
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
